    "assets:build": "node scripts/build-asset-library.mjs",
    "test:assets": "node --test tests/asset-library-catalog.test.mjs"
  },
  "dependencies": {
    "@tabler/icons": "3.50.0",
    "blobshape": "1.0.0",
    "geopattern": "1.2.3",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "coolshapes-react": "1.0.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
