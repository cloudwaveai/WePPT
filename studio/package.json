{
  "name": "weppt-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test:backend": "node --test tests/backend.test.mjs",
    "setup:skills": "python -X utf8 scripts/setup-upstream-skills.py",
    "skills:status": "node scripts/skill-tools.mjs status",
    "skills:convert-svg": "node scripts/skill-tools.mjs convert-svg",
    "setup:slidev": "node scripts/setup-slidev-runtime.mjs",
    "setup:pptagent": "python -X utf8 scripts/setup-pptagent-runtime.py --install",
